{
  "name": "gladys-danfoss-ally",
  "version": "0.1.0",
  "private": true,
  "description": "External Gladys Assistant integration for Danfoss Ally radiator thermostats, room sensors and Icon room thermostats through the official Danfoss Ally API: setpoint, heating mode, temperatures, window, battery, child lock, scene triggers and actions, dashboard widgets.",
  "homepage": "https://github.com/William-De71/gladys-danfoss-ally",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-danfoss-ally.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "danfoss",
    "danfoss-ally",
    "danfoss-icon",
    "thermostat",
    "radiator",
    "home-automation"
  ]
}
